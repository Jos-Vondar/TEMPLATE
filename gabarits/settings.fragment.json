{
  "_claudeos": "Fragment de réglages du template, FUSIONNÉ dans ~/.claude/settings.json par engine/fusionner-reglages.py, jamais copié tel quel. Les clés qui commencent par un tiret bas ne partent pas : _si_proxy ne se fusionne que si reglages/REPONSES porte PROXY=oui. Un crochet dont la commande vise ~/.claude/engine/ appartient au template : la fusion le remplace, les tiens restent.",
  "autoMemoryDirectory": "~/.claude/memory",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/engine/boot-check.sh\"",
            "statusMessage": "ClaudeOS : bilan de démarrage…"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/engine/hooks/rappel-fichiers-nommage.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "spinnerTipsOverride": {
    "label": "ClaudeOS",
    "tipsFile": "~/.claude/installateur/ASTUCES.json",
    "excludeDefault": false
  },
  "_si_proxy": {
    "hooks": {
      "PreToolUse": [
        {
          "matcher": "Bash",
          "hooks": [
            {
              "type": "command",
              "command": "rtk hook claude"
            }
          ]
        }
      ]
    }
  }
}
